# Copy to .env and adjust. .env is gitignored; this file is committed.
# Every variable is optional — the defaults in app/config.py are used
# when a variable is absent.

# --- API metadata (shown on /docs) ---
API_TITLE=Iris Classifier API
API_VERSION=1.0.0

# --- model ---
# Relative paths are resolved against the project root, so this works
# no matter which directory you start uvicorn from.
MODEL_PATH=ml/saved_model/model.joblib

# --- logging ---
# One of DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_MAX_BYTES=1000000
LOG_BACKUP_COUNT=5

# --- limits ---
# Largest number of rows /api/v1/predict-batch will accept in one call.
MAX_BATCH_SIZE=100

# --- API security ---
# Use a long, random secret. Never commit the real value.
API_KEY=replace-with-a-long-random-secret
# Comma-separated browser origins allowed to call the API. Leave blank to
# disable browser cross-origin calls until a frontend origin is known.
CORS_ORIGINS=http://localhost:3000
